{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "btc-impulse-alt-lag-4h-dry-run",
  "initial_state": "stopped",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.1,
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 1.0,
  "fiat_display_currency": "USD",
  "timeframe": "4h",
  "process_only_new_candles": true,
  "ignore_buying_expired_candle_after": 60,
  "cancel_open_orders_on_exit": true,
  "fee": 0.001,
  "exchange": {
    "name": "binance",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "ETH/USDT:USDT",
      "SOL/USDT:USDT",
      "BNB/USDT:USDT",
      "XRP/USDT:USDT",
      "LINK/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "telegram": {
    "enabled": false
  },
  "internals": {
    "process_throttle_secs": 5
  },
  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather",
  "db_url": "sqlite:////freqtrade/user_data/trades-lead-lag-dry-run.sqlite",
  "lead_lag_risk_state_path": "/freqtrade/user_data/data/lead_lag_risk_state.json",
  "lead_lag_audit_path": "/freqtrade/user_data/logs/lead_lag_execution.jsonl"
}
